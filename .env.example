# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/lennox_fields"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# Encryption Keys (HIPAA Compliance)
MASTER_ENCRYPTION_KEY="your-master-encryption-key-change-in-production"
PHI_ENCRYPTION_KEY="your-phi-encryption-key-change-in-production"

# Stripe Configuration
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email Configuration (HIPAA-compliant)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tamara@lennoxfields.org"
SMTP_PASSWORD="your-email-password"
EMAIL_FROM="tamara@lennoxfields.org"

# CarePatron Integration (Optional)
CAREPATRON_API_KEY="your-carepatron-api-key"
CAREPATRON_ORGANIZATION_ID="your-organization-id"

# Application Settings
NODE_ENV="development"
SESSION_TIMEOUT=900000
ENABLE_HIPAA_LOGGING=true

# Domain Configuration
DOMAIN="lennoxfields.org"
ADMIN_EMAIL="tamara@lennoxfields.org"
