# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/lennox_fields"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-in-production"

# Encryption Keys (HIPAA Compliance)
MASTER_ENCRYPTION_KEY="your-master-encryption-key-change-in-production"
PHI_ENCRYPTION_KEY="your-phi-encryption-key-change-in-production"

# Stripe Configuration
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email — Contact Form (Resend)
# REQUIRED: Get your API key from resend.com and add it to Vercel env vars.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# OPTIONAL: Override the recipient. Defaults to tamara@lennoxfields.com.
CONTACT_TO_EMAIL="tamara@lennoxfields.com"
# OPTIONAL: The From address. Must be a verified domain/address in Resend.
# Until lennoxfields.com is verified in Resend, leave blank to use Resend's
# free test sender (onboarding@resend.dev). Emails will still arrive but
# show as coming from the test sender.
CONTACT_FROM_EMAIL="Lennox Fields <hello@lennoxfields.com>"

# Legacy SMTP (no longer used — kept for reference)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="tamara@lennoxfields.com"
# SMTP_PASSWORD="your-email-password"
# EMAIL_FROM="tamara@lennoxfields.com"

# CarePatron Integration (Optional)
CAREPATRON_API_KEY="your-carepatron-api-key"
CAREPATRON_ORGANIZATION_ID="your-organization-id"

# Application Settings
NODE_ENV="development"
SESSION_TIMEOUT=900000
ENABLE_HIPAA_LOGGING=true

# Domain Configuration
DOMAIN="lennoxfields.com"
ADMIN_EMAIL="tamara@lennoxfields.com"
