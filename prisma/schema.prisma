// Lennox Fields Clinical Mental Health Services - Database Schema
// HIPAA-compliant data model with encryption for PHI

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User Authentication and Authorization
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          UserRole  @default(CLIENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLogin     DateTime?

  // Relations
  client        Client?
  therapist     Therapist?
  sessions      Session[]

  @@index([email])
  @@map("users")
}

enum UserRole {
  CLIENT
  THERAPIST
  ADMIN
  SUPERVISOR
}

// Client Information (PHI - Encrypted)
model Client {
  id                String    @id @default(cuid())
  userId            String    @unique
  mrn               String    @unique // Medical Record Number
  encryptedName     String    // Encrypted full name
  encryptedContact  String    // Encrypted contact info
  dateOfBirth       DateTime
  status            ClientStatus @default(ACTIVE)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions          Session[]
  treatmentPlans    TreatmentPlan[]
  assessments       Assessment[]
  documents         Document[]
  progressNotes     ProgressNote[]

  @@index([mrn])
  @@map("clients")
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  DISCHARGED
  WAITLIST
}

// Therapist/Clinician Information
model Therapist {
  id                String    @id @default(cuid())
  userId            String    @unique
  name              String
  credentials       String[]  // ["M.Ed", "LPCA"]
  specialties       String[]
  licenseNumber     String?
  licenseState      String[]  // ["NC", "IN"]
  bio               String?
  photoUrl          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions          Session[]
  treatmentPlans    TreatmentPlan[]
  supervisionLogs   SupervisionLog[]

  @@map("therapists")
}

// Clinical Sessions
model Session {
  id                String    @id @default(cuid())
  clientId          String
  therapistId       String
  userId            String
  sessionType       SessionType
  sessionDate       DateTime
  duration          Int       // minutes
  encryptedNotes    String?   // Encrypted session notes
  status            SessionStatus @default(SCHEDULED)
  billingStatus     BillingStatus @default(PENDING)
  amount            Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  therapist         Therapist @relation(fields: [therapistId], references: [id])
  user              User      @relation(fields: [userId], references: [id])

  @@index([clientId, sessionDate])
  @@index([therapistId, sessionDate])
  @@map("sessions")
}

enum SessionType {
  INDIVIDUAL_THERAPY
  COUPLES_THERAPY
  FAMILY_THERAPY
  TEEN_THERAPY
  CAREER_COUNSELING
  CLINICAL_SUPERVISION
  INTAKE
  FOLLOW_UP
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum BillingStatus {
  PENDING
  PAID
  INSURANCE_SUBMITTED
  INSURANCE_PAID
  OVERDUE
}

// Treatment Plans
model TreatmentPlan {
  id                String    @id @default(cuid())
  clientId          String
  therapistId       String
  diagnoses         String[]
  presentingProblem String
  longTermGoals     Json      // Array of goal objects
  shortTermGoals    Json      // Array of goal objects
  interventions     Json      // Array of intervention objects
  modality          String[]
  frequency         String
  measurableOutcomes Json     // Array of outcome objects
  reviewDate        DateTime
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  therapist         Therapist @relation(fields: [therapistId], references: [id])

  @@index([clientId])
  @@map("treatment_plans")
}

// Clinical Assessments
model Assessment {
  id                String    @id @default(cuid())
  clientId          String
  assessmentType    AssessmentType
  scores            Json      // Structured score data
  results           Json      // Detailed results
  interpretation    String?
  completedAt       DateTime  @default(now())
  createdAt         DateTime  @default(now())

  // Relations
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, assessmentType])
  @@map("assessments")
}

enum AssessmentType {
  BECK_DEPRESSION
  GAD7_ANXIETY
  ADHD_ASRS
  AUTISM_AQ
  PTSD_PCL5
  ASAM_CRITERIA
  STRONG_INTEREST
  MBTI
  HOLLAND_CODE
  CUSTOM
}

// Progress Notes
model ProgressNote {
  id                String    @id @default(cuid())
  clientId          String
  noteType          NoteType
  encryptedContent  String    // Encrypted note content
  sessionDate       DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, sessionDate])
  @@map("progress_notes")
}

enum NoteType {
  SOAP
  DAP
  BIRP
  CUSTOM
}

// Document Storage (HIPAA-compliant)
model Document {
  id                String    @id @default(cuid())
  clientId          String
  fileName          String
  encryptedFilePath String    // Encrypted file location
  fileType          String
  fileSize          Int
  uploadedAt        DateTime  @default(now())

  // Relations
  client            Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("documents")
}

// Resources (Worksheets, Journals, etc.)
model Resource {
  id                String    @id @default(cuid())
  title             String
  description       String?
  category          ResourceCategory
  type              ResourceType
  content           String?   // For text-based resources
  filePath          String?   // For downloadable resources
  isPremium         Boolean   @default(false)
  isPublic          Boolean   @default(true)
  tags              String[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([category, type])
  @@map("resources")
}

enum ResourceCategory {
  WORKSHEET
  HABIT_TRACKER
  JOURNAL
  INFORMATION_SHEET
  SAFETY_PLAN
  SCREENING_TOOL
  PROFESSIONAL_TOOL
}

enum ResourceType {
  PDF
  INTERACTIVE
  TEMPLATE
  GUIDE
}

// Supervision Logs (for professional development)
model SupervisionLog {
  id                String    @id @default(cuid())
  therapistId       String
  superviseeName    String
  sessionDate       DateTime
  hours             Float
  type              SupervisionType
  encryptedNotes    String?
  signatureUrl      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  therapist         Therapist @relation(fields: [therapistId], references: [id])

  @@index([therapistId, sessionDate])
  @@map("supervision_logs")
}

enum SupervisionType {
  INDIVIDUAL
  GROUP
  TRIADIC
}

// Books/Publishing
model Book {
  id                String    @id @default(cuid())
  title             String
  description       String
  ageRange          String
  topics            String[]
  isbn              String?   @unique
  coverImageUrl     String?
  previewUrl        String?
  price             Float
  stripeProductId   String?
  stripePriceId     String?
  isPublished       Boolean   @default(false)
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  purchases         BookPurchase[]

  @@map("books")
}

// Book Purchases
model BookPurchase {
  id                String    @id @default(cuid())
  bookId            String
  customerEmail     String
  customerName      String
  amount            Float
  stripeSessionId   String    @unique
  purchasedAt       DateTime  @default(now())

  // Relations
  book              Book      @relation(fields: [bookId], references: [id])

  @@index([customerEmail])
  @@map("book_purchases")
}

// Audit Log (HIPAA Compliance Requirement)
model AuditLog {
  id                String    @id @default(cuid())
  userId            String
  action            String
  resourceType      String
  resourceId        String?
  ipAddress         String?
  userAgent         String?
  timestamp         DateTime  @default(now())

  @@index([userId, timestamp])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

// ============================================================
// Tethered Together — Shared Family/Couples Task Management
// Inspired by Eve Rodsky's Fair Play framework
// ============================================================

model TetherUser {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  displayName   String
  avatarColor   String?   // Personalized color for task claiming UI
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   TetherMember[]
  claimedTasks  TetherTask[]   @relation("TaskClaimedBy")
  createdTasks  TetherTask[]   @relation("TaskCreatedBy")

  @@map("tether_users")
}

model TetherFamily {
  id            String    @id @default(cuid())
  name          String    // e.g. "The Walls Family"
  inviteCode    String    @unique @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  members       TetherMember[]
  lists         TetherList[]
  goals         TetherGoal[]

  @@map("tether_families")
}

model TetherMember {
  id            String       @id @default(cuid())
  userId        String
  familyId      String
  displayName   String
  role          TetherRole   @default(PARTNER)
  joinedAt      DateTime     @default(now())

  user          TetherUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family        TetherFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@map("tether_members")
}

enum TetherRole {
  PARTNER
  THERAPIST
}

model TetherList {
  id              String          @id @default(cuid())
  familyId        String
  name            String          // e.g. "Monday Tasks", "Weekly Household"
  listType        TetherListType  @default(DAILY)
  deadline        DateTime?       // Custom deadline for the list
  bedtimeTarget   String?         // Time string "20:30" for bedtime countdown
  closedForDay    Boolean         @default(false)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  family          TetherFamily    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  tasks           TetherTask[]

  @@index([familyId, listType])
  @@map("tether_lists")
}

enum TetherListType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

model TetherTask {
  id              String             @id @default(cuid())
  listId          String
  title           String
  description     String?
  claimedById     String?
  createdById     String
  ownership       TetherOwnership    @default(UNCLAIMED)
  status          TetherTaskStatus   @default(PENDING)
  priority        Int                @default(0)
  dueAt           DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  list            TetherList         @relation(fields: [listId], references: [id], onDelete: Cascade)
  claimedBy       TetherUser?        @relation("TaskClaimedBy", fields: [claimedById], references: [id])
  createdBy       TetherUser         @relation("TaskCreatedBy", fields: [createdById], references: [id])

  @@index([listId, status])
  @@map("tether_tasks")
}

enum TetherOwnership {
  UNCLAIMED
  INDIVIDUAL
  BOTH
}

enum TetherTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

model TetherGoal {
  id            String            @id @default(cuid())
  familyId      String
  title         String
  description   String?
  status        TetherGoalStatus  @default(ACTIVE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  family        TetherFamily      @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@map("tether_goals")
}

// ============================================================
// Paywall / Auth — NextAuth + Stripe subscription models
// Auth-prefixed to avoid collision with clinical User/Session
// ============================================================

model AuthUser {
  id                   String              @id @default(cuid())
  email                String?             @unique
  emailVerified        DateTime?
  name                 String?
  image                String?
  stripeCustomerId     String?             @unique
  subscriptionId       String?             @unique
  subscriptionStatus   String?
  subscriptionPriceId  String?
  subscriptionEnds     DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  accounts             AuthAccount[]
  sessions             AuthSession[]
  verificationTokens   VerificationToken[]
  toolAssignments      ToolAssignment[]
  toolResponses        ToolResponse[]

  @@map("auth_users")
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  id_token          String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  session_state     String?

  user              AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}

model AuthSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  userId     String?

  user       AuthUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ToolAssignment {
  id           String    @id @default(cuid())
  therapistId  String
  tool         String
  clientEmail  String
  clientName   String
  token        String    @unique @default(cuid())
  tokenExpires DateTime
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  therapist    AuthUser      @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  responses    ToolResponse[]

  @@index([therapistId])
  @@index([token])
  @@map("tool_assignments")
}

model ToolResponse {
  id           String   @id @default(cuid())
  assignmentId String
  therapistId  String
  responseData Json
  submittedAt  DateTime @default(now())

  assignment   ToolAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  therapist    AuthUser       @relation(fields: [therapistId], references: [id])

  @@index([assignmentId])
  @@index([therapistId])
  @@map("tool_responses")
}

enum TetherGoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}
